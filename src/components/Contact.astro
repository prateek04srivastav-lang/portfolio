---
import { site } from '../data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow" data-reveal>Contact</p>
    <h2 id="contact-title" class="display contact__title" data-reveal>
      Let’s make the<br />complex <em>clear.</em>
    </h2>
    <p class="lead" data-reveal>
      {site.availability}. I’d love to hear about your product, your team and the problems worth solving.
    </p>

    <div class="contact__email" data-reveal style="margin-top:40px">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <button class="copy-btn" type="button" data-copy={site.email} aria-label="Copy email address">
        <span data-copy-label>Copy</span>
      </button>
    </div>

    <div class="contact__actions" data-reveal>
      <a class="btn" href={site.linkedin} target="_blank" rel="noopener">
        LinkedIn <span class="arrow" aria-hidden="true">↗</span>
      </a>
      {
        site.resume ? (
          <a class="btn btn--ghost" href={site.resume} target="_blank" rel="noopener">
            View resume <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="btn btn--ghost" aria-disabled="true" title="Add your resume PDF — see README">
            Resume — <mark class="ph">coming soon</mark>
          </span>
        )
      }
      <a class="btn btn--ghost" href={site.behance} target="_blank" rel="noopener">
        Behance <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
