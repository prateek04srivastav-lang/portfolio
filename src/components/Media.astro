---
// Shows an image — or, while no image is set, a clearly labelled placeholder.
import type { Media } from '../data/projects';

interface Props {
  media: Media;
  /** "cover" shows a typographic poster instead of a dashed box. */
  variant?: 'box' | 'cover';
  title?: string;
  accent?: 'lime' | 'orange' | 'sand';
  eager?: boolean;
}
const { media, variant = 'box', title = '', accent = 'lime', eager = false } = Astro.props;
const ratio = media.ratio ?? '16/10';
---

<figure class:list={['media', `media--${variant}`, `accent-${accent}`, { 'media--captioned': media.src && media.caption }]} style={`--ratio:${ratio}`}>
  {
    media.src ? (
      <img src={media.src} alt={media.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : variant === 'cover' ? (
      <div class="media__poster" role="img" aria-label={`${title} — cover image coming soon`}>
        <span class="media__poster-title" aria-hidden="true">{title}</span>
        <span class="media__tag">Cover image placeholder</span>
      </div>
    ) : (
      <div class="media__placeholder" role="img" aria-label={`Placeholder: ${media.alt}`}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5" />
          <circle cx="9" cy="10" r="2" stroke="currentColor" stroke-width="1.5" />
          <path d="M21 16l-5-5-8 8" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="media__tag">Placeholder</span>
        <span class="media__hint">{media.hint ?? media.alt}</span>
      </div>
    )
  }
  {media.caption && <figcaption>{media.caption}</figcaption>}
</figure>
