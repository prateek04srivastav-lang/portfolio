---
import { site } from '../data/site';

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a class="nav__brand" href="/" aria-label={`${site.name} — home`}>
      <span class="avatar" data-avatar aria-hidden="true">
        <svg viewBox="0 0 48 48" width="44" height="44">
          <circle cx="24" cy="24" r="24" class="avatar__bg" />
          <g class="avatar__figure">
            <path d="M4 48c1.500-8.500 8-13 20-13s18.500 4.500 20 13z" class="avatar__body" />
            <path d="M17.500 35.500 24 45l6.500-9.500c-2 1.200-4 1.800-6.500 1.800s-4.500-.6-6.500-1.800z" class="avatar__shirt" />
            <path d="M16 35.800 22.500 47l-9-.2zM32 35.800 25.500 47l9-.2z" class="avatar__lapel" />
            <rect x="21" y="29" width="6" height="8" rx="2.500" class="avatar__skin avatar__neck" />
            <ellipse cx="14.200" cy="23.500" rx="1.800" ry="2.600" class="avatar__skin" />
            <ellipse cx="33.800" cy="23.500" rx="1.800" ry="2.600" class="avatar__skin" />
            <circle cx="14.300" cy="25.600" r="0.900" class="avatar__stud" />
            <path d="M14.500 20.500c0-6 4.200-10.500 9.500-10.500s9.500 4.500 9.500 10.500c0 6.500-1.500 11.500-3.600 13.600-1.400 1.400-3.400 2.400-5.900 2.400s-4.500-1-5.900-2.400c-2.100-2.100-3.600-7.100-3.600-13.600z" class="avatar__skin" />
            <path d="M16.400 27c1 4.800 3.400 7.800 7.600 7.800s6.600-3 7.600-7.800c-.8 3.400-3 5-7.600 5s-6.800-1.600-7.600-5z" class="avatar__stubble" />
            <path d="M14.200 20.500C12.600 13.500 16 8.500 21 6.400 25 4.200 31 4.800 34 8.800c2 2.800 1.800 7.600 0 11.700-.4-3.200-1.600-5-3.600-6.200-3.200 1-7.600 1-10.800-.4-2.500 1.200-4.600 3.400-5.400 6.600z" class="avatar__hair" />
            <path d="M18.600 10.800c2.400-3.800 8-5 13.200-2.400-5-.2-9.400.4-13.200 2.400z" class="avatar__hl" />
            <path d="M21.500 7.600c2.800-1.400 6.400-1 8.600.6-2.800-.6-5.600-.6-8.600-.6z" class="avatar__hl" />
            <path d="M16.800 20.200c1.300-1 2.800-1.200 4.200-.6M27 19.600c1.400-.6 2.900-.4 4.200.6" class="avatar__brow" />
            <g class="avatar__eyes">
              <ellipse class="avatar__eye" cx="19.800" cy="23" rx="1.500" ry="1.700" />
              <ellipse class="avatar__eye" cx="28.200" cy="23" rx="1.500" ry="1.700" />
            </g>
            <path d="M24 24.800c-.5 1.600-.8 2.200.2 2.500" class="avatar__nose" />
            <path d="M20.300 29.600c2 1.800 5.400 1.800 7.400 0" class="avatar__smile" />
          </g>
        </svg>
      </span>
      <span class="nav__id">
        <span class="nav__name">{site.name}</span>
        <span class="nav__role">Senior UI/UX Designer</span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="nav__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-nav-link={link.href.replace('/#', '')}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const avatar = document.querySelector<HTMLElement>('[data-avatar]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (avatar && !reduce) {
    window.addEventListener(
      'pointermove',
      (e) => {
        const r = avatar.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const d = Math.hypot(dx, dy) || 1;
        const k = Math.min(1, d / 200);
        avatar.style.setProperty('--ex', `${((dx / d) * 1.4 * k).toFixed(2)}px`);
        avatar.style.setProperty('--ey', `${((dy / d) * 1.2 * k).toFixed(2)}px`);
      },
      { passive: true },
    );
  }
</script>
