---
import type { Project } from '../data/projects';
import Media from './Media.astro';
import Rich from './Rich.astro';

interface Props {
  project: Project;
  index: number;
  wide?: boolean;
}
const { project, index, wide = false } = Astro.props;
---

<a class:list={['card', { 'card--wide': wide }]} href={`/work/${project.slug}`} data-reveal>
  <Media media={project.cover} variant="cover" title={project.title} accent={project.accent} />
  <div class="card__body">
    <div class="card__top">
      <div>
        <span class="card__index">{String(index + 1).padStart(2, '0')} — <Rich text={project.category} /></span>
        <h3 class="card__title">{project.title}</h3>
      </div>
      <span class="card__arrow" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 10h12m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.6" /></svg>
      </span>
    </div>
    <Rich as="p" class="card__tagline" text={project.tagline} />
    <div class="card__meta">
      <span class:list={['chip', 'chip--kind', { 'chip--product': project.kind === 'Product work' }]}>{project.kind}</span>
      <span class="chip">Role:&nbsp;<Rich text={project.role} /></span>
      <span class="chip"><Rich text={project.context} /></span>
    </div>
    <span class="visually-hidden">Read the {project.title} case study</span>
  </div>
</a>
