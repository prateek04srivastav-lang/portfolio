---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import Media from '../components/Media.astro';
import Rich from '../components/Rich.astro';
import { site, hero, experience, process, about } from '../data/site';
import { projects, archive, prototypes } from '../data/projects';
import { countPlaceholders } from '../scripts/rich';

// Words wrapped in *asterisks* in the headline are set in the italic serif.
const words = hero.lines.flatMap((line, l) =>
  line.split(' ').map((word) => ({ line: l, word: word.replace(/\*/g, ''), em: word.startsWith('*') })),
);
const fullHeadline = `${hero.lines.join(' ').replace(/\*/g, '')} ${hero.rotating.join(', ')}`;
const marqueeItems = ['Enterprise SaaS', 'AI-powered products', 'Complex workflows', 'Dashboards', 'Design systems', 'Information architecture', 'Prototyping'];

const placeholderCount = countPlaceholders({ projects: projects.map(({ title, tagline, role, context, category }) => ({ title, tagline, role, context, category })), experience, site });
---

<Layout placeholderCount={placeholderCount}>
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">{site.name} · {hero.eyebrow}</p>
      <h1 id="hero-title" class="display hero__title">
        <span class="visually-hidden">{fullHeadline}</span>
        <span aria-hidden="true">
          {
            hero.lines.map((_, l) => (
              <span class="hero__line">
                {words
                  .filter((w) => w.line === l)
                  .map((w, i) => (
                    <span style={`--i:${l * 2 + i}`}>{w.em ? <em>{w.word}</em> : w.word}&nbsp;</span>
                  ))}
              </span>
            ))
          }
          <span class="hero__line">
            <span style={`--i:${hero.lines.length * 2 + 1}`}>
              <span class="rotator" data-rotator>
                {hero.rotating.map((word, i) => <span class:list={['rotator__word', { 'is-active': i === 0 }]}>{word}</span>)}
              </span>
            </span>
          </span>
        </span>
      </h1>

      <div class="hero__bottom" data-reveal>
        <p class="lead">{hero.intro}</p>
        <div class="hero__stats">
          {
            hero.stats.map((s) => (
              <div>
                <div class="stat__value">{s.value}</div>
                <div class="stat__label">{s.label}</div>
              </div>
            ))
          }
        </div>
        <div style="display:grid;gap:16px;justify-items:start">
          <a class="btn" href="#work">View my work <span class="arrow" aria-hidden="true">↓</span></a>
          <span class="hero__status">{site.availability}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...marqueeItems, ...marqueeItems].map((item) => <span>{item}</span>)}
    </div>
  </div>

  <!-- ── Selected work ────────────────────────────────── -->
  <section id="work" class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow" data-reveal>Selected work</p>
          <h2 id="work-title" class="h-section" data-reveal style="margin-top:20px">
            Products with <em>real</em><br />complexity.
          </h2>
        </div>
        <p class="lead" data-reveal>
          Enterprise platforms, AI-assisted workflows and data-heavy dashboards — each case study walks through the problem, the
          decisions and the design.
        </p>
      </div>

      <div class="work-grid">
        {projects.map((project, i) => <ProjectCard project={project} index={i} wide={i < 2} />)}
      </div>
    </div>
  </section>

  <!-- ── Experience ───────────────────────────────────── -->
  <section id="experience" class="section theme-light" aria-labelledby="exp-title">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow" data-reveal>Experience</p>
          <h2 id="exp-title" class="h-section" data-reveal style="margin-top:20px">Where I’ve <em>shipped.</em></h2>
        </div>
        <p class="lead" data-reveal>From field-inspection mobile apps to AI-powered enterprise analytics.</p>
      </div>

      <div class="exp">
        {
          experience.map((job) => (
            <article class="exp__item" data-reveal>
              <div>
                <h3 class="exp__company">{job.company}</h3>
                <p class="exp__role">{job.role}</p>
                <Rich as="p" class="exp__period" text={job.period} />
              </div>
              <div>
                <p class="exp__summary">{job.summary}</p>
                <ul class="exp__points">
                  {job.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <div class="chips">
                  {job.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Process ──────────────────────────────────────── -->
  <section id="process" class="section theme-light" style="padding-top:0" aria-labelledby="process-title">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow" data-reveal>UX process</p>
          <h2 id="process-title" class="h-section" data-reveal style="margin-top:20px">How I <em>work.</em></h2>
        </div>
        <p class="lead" data-reveal>
          A flexible, evidence-led process — scaled up or down depending on the problem, the timeline and what we already know.
        </p>
      </div>

      <ol class="process">
        {
          process.map((step, i) => (
            <li class="process__step" data-reveal style={`--d:${i % 4}`}>
              <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="process__title">{step.title}</h3>
              <p class="process__text">{step.text}</p>
            </li>
          ))
        }
        <li class="process__step process__step--final" data-reveal style="--d:3">
          <span class="process__num">→</span>
          <h3 class="process__title">See it applied</h3>
          <p class="process__text"><a href="#work">Browse the case studies</a> to see these steps in real projects.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────── -->
  <section id="about" class="section" aria-labelledby="about-title">
    <div class="container">
      <p class="eyebrow" data-reveal>About</p>
      <h2 id="about-title" class="h-section" data-reveal style="margin:20px 0 clamp(48px,7vw,96px)">
        Designer with a <em>builder’s</em> mind.
      </h2>
      <div class="about">
        <div class="about__photo" data-reveal>
          <Media media={{ src: '/images/profile/prateek.jpg', alt: 'Portrait of Prateek Srivastav', ratio: '4/5' }} />
        </div>
        <div>
          <p class="about__intro" data-reveal>{about.intro}</p>
          <div class="about__body" data-reveal>
            {about.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="skills">
            {
              about.skills.map((group, i) => (
                <div data-reveal style={`--d:${i}`}>
                  <h3>{group.group}</h3>
                  <div class="chips">
                    {group.items.map((item) => (
                      <span class="chip">{item}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── More work ────────────────────────────────────── -->
  <section id="more-work" class="section" style="padding-top:0" aria-labelledby="more-title">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow" data-reveal>More work</p>
          <h2 id="more-title" class="h-section" data-reveal style="margin-top:20px">Explorations.</h2>
        </div>
        <p class="lead" data-reveal>Mobile apps, concepts and redesigns. Each opens on Behance or Figma.</p>
      </div>
      <div class="archive">
        {
          archive.map((item, i) => (
            <a class="archive__item" href={item.url} target="_blank" rel="noopener" data-reveal style={`--d:${i % 4}`}>
              <Media media={{ src: item.image, alt: `${item.title} — ${item.type}`, ratio: '4/3' }} />
              <div>
                <h3>
                  {item.title} <span aria-hidden="true">↗</span>
                </h3>
                <p>{item.type}</p>
              </div>
            </a>
          ))
        }
      </div>
      <div class="proto-list" data-reveal>
        <span class="muted" style="margin-right:6px">Figma prototypes:</span>
        {
          prototypes.map((p) => (
            <a class="chip" href={p.url} target="_blank" rel="noopener">
              {p.title} ↗
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Contact />
</Layout>
